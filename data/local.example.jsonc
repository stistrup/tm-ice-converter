// the GUI's setup writes local.jsonc in the user folder from this (%LOCALAPPDATA%\TmIceConverter, ~/.local/share/TmIceConverter)
{
  "paths": {
    // Documents/Trackmania
    "trackmania": "",
    // OpenplanetNext
    "openplanet": "",
    // game install folder
    "game": "",
    // only needed on Linux
    "importerWinePrefix": "~/.local/share/tm-ice-wine",
    // optional: caches and built pieces (default: the user's local app data, TmIceConverter)
    "cache": "",
    // optional: where conversion runs and GUI drafts are kept (default: settings/ in the repo)
    "settings": "",
    // optional: the uploader also mirrors each upload to <releaseCopy>/<version>
    "releaseCopy": ""
  },
  // "Me as author" (convert --me-as-author); the GUI's Convert popup can fill it in
  "testrunAuthor": { "login": "", "nickname": "", "zone": "World|<continent>|<country>" }
}
