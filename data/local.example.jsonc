// copy to data/local.jsonc and fill in
{
  "paths": {
    // Documents/Trackmania
    "trackmania": "",
    // OpenplanetNext
    "openplanet": "",
    // game install folder
    "game": "",
    // only needed on Linux
    "importerWinePrefix": "~/.local/share/tm-ice-wine",
    // where --final and --release write, under Maps
    "finishedFolder": "ICE finished",
    // optional: where conversion runs and GUI drafts are kept (default: settings/ in the repo)
    "settings": "",
    // optional: the uploader also mirrors each upload to <releaseCopy>/<version>
    "releaseCopy": ""
  },
  // only for --testrun
  "testrunAuthor": { "login": "", "nickname": "", "zone": "World|<continent>|<country>" }
}
