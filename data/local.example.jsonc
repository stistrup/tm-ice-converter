// the GUI's setup writes local.jsonc in the user folder from this (%LOCALAPPDATA%\TmSurfaceEditor, ~/.local/share/TmSurfaceEditor)
{
  "paths": {
    // Documents/Trackmania
    "trackmania": "",
    // OpenplanetNext
    "openplanet": "",
    // game install folder
    "game": "",
    // only needed on Linux
    "importerWinePrefix": "~/.local/share/tm-ice-wine",
    // optional: caches and built pieces (default: the user's local app data, TmSurfaceEditor)
    "cache": "",
    // optional: where conversion runs and each map's settings are kept (default: settings/ in the user folder)
    "settings": ""
  },
  // "Me as author" (convert --me-as-author); the GUI's Convert popup can fill it in
  "testrunAuthor": { "login": "", "nickname": "", "zone": "World|<continent>|<country>" }
}
