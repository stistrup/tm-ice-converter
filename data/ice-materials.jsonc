// Nadeo material -> NadeoImporter material
{
  "RoadTech": "PlatformIce_PlatformTech",
  "RoadDirt": "PlatformIce_PlatformTech",
  "PlatformTech": "PlatformIce_PlatformTech",
  "TrackBorders": "TrackBorders",
  "CollisionTrackBorder": "TrackBorders",

  "Technics": "Technics",
  "TechnicsTrims": "TechnicsTrims",
  "TechnicsTrimsColorize": "TechnicsTrims",
  "LightSpot": "LightSpot",
  "DecalPaint2Logo4x1": "DecalPaint2Logo4x1",

  // timer screens behind the digits
  "ChronoCheckpoint": "native",
  "ChronoFinish": "native",

  // empty = left out
  // per block: "<block pattern>|<material>"
  // the black band where the tech road turns into the bump road; on ice both sides look alike
  "*ToRoadBump*|DecalMarks": "",
  "GrassFence": "",
  "Water": "",
  "SeaFloor": "",
  "WaterBottom": "",
  "LightShape": "",

  "ThemeSnowRoad": "PlatformIce_PlatformTech",
  // "native": the game's own material (not in the importer library), linked after import
  "ThemeSnowRoadBorder": "native",
  "DecoHill": "PlatformIce_DecoHill",
  "DecoHill2": "PlatformIce_DecoHill2",
  "Deco": "PlatformIce_DecoHill",
  "Penalty": "PlatformIce_DecoHill",
  "Grass": "PlatformIce_DecoHill",
  "Land": "PlatformIce_DecoHill",
  "HillPxz": "PlatformIce_DecoHill",
  "TransitionRocksToLand": "PlatformIce_DecoHill",
  // terrain blend shaders, named after the shader
  "Tech3 Block PyPxz_Ids": "PlatformIce_DecoHill",
  "Tech3 Block PyPxz_Ids_Tex": "PlatformIce_DecoHill",
  "DecoCliff": "PlatformIce_DecoHill2",
  "DecoCliffBase": "PlatformIce_DecoHill2",
  "OpenTechBorders": "PlatformIce_OpenTechBorders",
  "DecalPlatform": "PlatformIce_DecalPlatform",
  "DecalPaintSponsor4x1NoColorizeA": "DecalPaintSponsor4x1A",
  "DecalPaintSponsor4x1NoColorizeB": "DecalPaintSponsor4x1B",
  "DecalPaintSponsor4x1NoColorizeC": "DecalPaintSponsor4x1C",
  "DecalPaintSponsor4x1NoColorizeD": "DecalPaintSponsor4x1D",
  "RoadBump": "PlatformIce_PlatformTech",
  "CollisionMetal": "Technics",
  // "item:" only applies to item copies
  "ItemInflatableTube": "PlatformIce_PlatformTech",
  "item:CollisionMetal": "PlatformIce_PlatformTech",
  // "skin:" only applies to skins; PlatformIce_DecoHill shows the vista's ground near the terrain
  "skin:Deco": "CustomSnow",
  "skin:DecoHill": "CustomSnow",
  "skin:DecoHill2": "CustomSnow",
  "skin:Grass": "CustomSnow",
  "skin:Land": "CustomSnow",
  "skin:Penalty": "CustomSnow",
  // "top:" only applies to top skins
  "top:TrackWall": "PlatformIce_PlatformTech",
  "top:TrackWallClips": "PlatformIce_PlatformTech",
  "top:Structure": "PlatformIce_PlatformTech",
  "ItemInflatableMat": "PlatformIce_PlatformTech",
  "ItemInflatableFloor": "PlatformIce_PlatformTech",
  "ItemRamp": "PlatformIce_PlatformTech",
  "Unknown": "CustomConcrete",
  // no good glass in the library
  "CanopyGlass": "GlassWaterWall",
  "ItemObstacleLightOn": "LightSpot",
  "SpeedometerLight": "SpeedometerLight_Dyna",
  "ThemeRallyCastleBorders": "CustomConcrete",
  "ThemeRallyCastleWall": "CustomConcrete",
  "ThemeRallyCastleWallUV": "CustomConcrete",
  "Show4x1": "Ad4x1Screen",
  "TechnicsStep": "Technics",
  "CollisionIce": "PlatformIce_PlatformTech",
  "CollisionTurbo": "PlatformIce_PlatformTech",
  "RoadTechSubIce": "PlatformIce_PlatformTech",
  // the library's TrackWall/Structure render wood/black; the game's own look right
  "TrackWall": "native",
  "TrackWallClips": "native",
  "Structure": "native"
}
