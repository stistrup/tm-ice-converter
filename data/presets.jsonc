// a preset: group conversions in order (groups and methods as in groups.jsonc; "" = all groups, "original" takes targets away)
[
  { "name": "Roads: custom blocks", "steps": [{ "group": "roads", "method": "custom" }] },
  { "name": "Roads: surface skins", "steps": [{ "group": "roads", "method": "skin" }] },
  { "name": "Roads and scenery", "steps": [{ "group": "roads", "method": "custom" }, { "group": "scenery", "method": "tops" }] },
  {
    "name": "Whole map",
    "steps": [
      { "group": "roads", "method": "custom" },
      { "group": "scenery", "method": "tops" },
      { "group": "terrain", "method": "cover" },
      { "group": "trees", "method": "swapOnConverted" }
    ]
  }
]
