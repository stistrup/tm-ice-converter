// hand-written fixes, these win over the name rules
//   "From": "To" | null | { "to", "rotate", "offset", "variant", "subVariant" }
{
  // prefixes that look like surfaces but aren't
  "ignorePrefixes": [
    "StageTechnics",
    "TechnicsScreen"
  ],

  // per map in "maps", per run with --set name=value
  "options": {
    "removeForcedCameras": true,
    "keepPlasticWalls": false,
    "engineOffToReset": true,
    // wins over engineOffToReset
    "engineOffToPlain": false,
    // snow on open-zone sides
    "snowOnZoneSides": true,
    "effectsToGate": true
  },

  // per map: name, blocks, ignorePrefixes, options, keep, keepItems, removeItems ("Name x, y, z" for one placed item)
  "maps": {
    "Fall 2026 - 18": { "options": { "keepPlasticWalls": true } },
    "Fall 2026 - 05": { "options": { "engineOffToPlain": true } },
    "Fall 2026 - 02": { "options": { "snowOnZoneSides": false } },
    "Fall 2026 - 19": { "options": { "snowOnZoneSides": false } },
    // guide walls stay plastic
    "Egypt 2026": { "name": "Fall 2026 - 21 Egypt", "options": { "engineOffToPlain": true },
      "keepItems": ["InflatableBorder*", "InflatableMat1m*"],
      "removeItems": ["InflatableBorder1mCornerOut 1151.5, 66.5, 1264.5"] },
    "Czech Republic 2026": { "name": "Fall 2026 - 23 Czech Republic", "keepItems": ["InflatableBorder*"] },
    "United Kingdom 2026": { "name": "Fall 2026 - 22 United Kingdom" },
    "India 2026": { "name": "Fall 2026 - 24 India" },
    "New Zealand 2026": { "name": "Fall 2026 - 25 New Zealand" }
  },

  // ice blocks an environment lacks
  "unavailableIn": {
    "*": ["OpenIceZone"]
  },

  // item swaps by id
  "items": {
    "Fall": "WinterFrozenTree",
    "Spring": "WinterFrozenTree",
    "FallTreeBig": "FrozenTreeBig",
    "FallTreeMedium": "FrozenTreeMedium",
    "FallTreeSmall": "FrozenTreeSmall",
    "FallTreeTall": "FrozenTreeTall",
    "FallTreeVerySmall": "FrozenTreeVerySmall",
    "SpringTreeBig": "FrozenTreeBig",
    "SpringTreeMedium": "FrozenTreeMedium",
    "SpringTreeSmall": "FrozenTreeSmall",
    "SpringTreeTall": "FrozenTreeTall",
    "SpringTreeVerySmall": "FrozenTreeVerySmall",
    "FirMedium": "FirSnowMedium",
    "FirTall": "FirSnowTall"
  },

  // only for items touching converted ice
  "itemsOnSnow": {
    "TreePine": "Winter",
    "TreePineBigA2": "FirSnowTall",
    "TreePineBigA3": "FirSnowTall",
    "TreePineMediumA1": "FirSnowMedium",
    "TreePineMediumA3": "FirSnowMedium",
    "TreePineSmallA1": "FirSnowMedium",
    "TreePineSmallA2": "FirSnowMedium",
    "TreePineSmallA3": "FirSnowMedium",
    "Bush": "FrozenTreeVerySmall",
    "BushSmallC": "FrozenTreeVerySmall",
    "BushMediumA": "FrozenTreeVerySmall",
    "BushMediumB": "FrozenTreeVerySmall",
    "BushMediumD": "FrozenTreeVerySmall",
    "BushBigA": "FrozenTreeSmall",
    "BushBigB": "FrozenTreeSmall",
    "BushBigC": "FrozenTreeSmall",
    "BushBigD": "FrozenTreeSmall",
    "Cactus": "FrozenTreeSmall",
    "CactusSmallA": "FrozenTreeVerySmall",
    "CactusSmallC": "FrozenTreeVerySmall",
    "CactusSmallD": "FrozenTreeVerySmall",
    "CactusSmallE": "FrozenTreeVerySmall",
    "CactusBigC": "FrozenTreeSmall",
    "CactusBigD": "FrozenTreeSmall",
    "TreePineBig": "FirSnowTall",
