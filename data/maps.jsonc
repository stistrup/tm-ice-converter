// options and per-map choices
{
  // per map in "maps", per run with --set name=value
  "options": {
    "removeForcedCameras": true,
    "keepPlasticWalls": false,
    "engineOffToReset": false,
    // wins over engineOffToReset
    "engineOffToPlain": false,
    // snow on open-zone sides
    "snowOnZoneSides": true,
    // deco platforms on/in the ground: native ice + snow skin (off: faces at ground level dropped, terrain shows)
    "snowOnGroundDeco": true,
    "effectsToGate": false,
    // blocks that would become whole items become custom blocks instead (off: items)
    "customBlocks": true,
    // starts/checkpoints/finishes as custom blocks too
    "customWaypoints": true,
    // trees and plants become frozen/snowy ones (off: they stay as they are)
    "convertTrees": true,
    // deco blocks, pillars, concrete and walls get snow (off: they stay as they are; roads and platforms still convert)
    "convertScenery": true,
    // native blocks keep their place under an ice skin instead of becoming custom blocks (smaller maps, one ice look)
    "skinsOnly": false,
    // starts, checkpoints and finishes stay native under an ice skin (the largest custom blocks)
    "skinWaypoints": false,
    // custom blocks next to a skinned block lift their ice toward it, so the surfaces meet (experimental)
    "rampToSkins": false
  },

  // per map: name, blocks, ignorePrefixes, options, keep ("Name x,y,z" grid cell, "Name x, y, z" free block position), keepItems, removeItems ("Name x, y, z" for one placed item),
  // snowTerrain ([x0, z0, x1, z1] grid cell areas whose terrain, and deco set into it, becomes snow; water and cells with a block on them stay),
  // skinned ([x0, z0, x1, z1] grid cell areas whose blocks stay native under an ice skin instead of becoming custom blocks),
  // skinLiftCm (skin height over the native surface; default 2), skinEdgeDeg (skin edge slope; default 90 = straight down)
  "maps": {
    // the wallride wall stays plastic; the other plastic walls get ice
    "Fall 2026 - 18": { "keep": [
      "PlatformPlasticWallCurve2 1179.05, 64, 932.95", "PlatformPlasticWallCurve1 1179.05, 64, 1023.46",
      "PlatformPlasticWallStraightSponsorsBottom 1133.8, 64, 932.95", "PlatformPlasticWallOutCurve1 1133.8, 64, 932.95",
      "PlatformPlasticWallOutCurve0 1111.17, 64, 1000.83"] },
    // grass deco before the finish gate
    "Fall 2026 - 14": { "snowTerrain": [[33, 45, 35, 45], [34, 46, 34, 46]] },
    // the grass strip between the stands
    "Fall 2026 - 02": { "options": { "snowOnZoneSides": false }, "snowTerrain": [[47, 22, 53, 22]] },
    // grass gaps between road ends: after the S near the start, before the double U-turn;
    // skins: every checkpoint but the first, and the finish
    "Fall 2026 - 07": { "options": { "convertTrees": false, "convertScenery": false, "rampToSkins": true }, "snowTerrain": [[47, 21, 47, 21], [36, 44, 37, 44]],
      "skinned": [[43, 19, 43, 19], [42, 26, 42, 26], [34, 41, 34, 41], [34, 27, 34, 27]] },
    "Fall 2026 - 19": { "options": { "snowOnZoneSides": false } },
    // grass frame around the finish shapes the terrain
    "Fall 2026 - 12": { "keep": [
      "DecoPlatformSlopeBase 12,13,48", "DecoPlatformSlopeBase 12,13,49", "DecoPlatformSlopeBase 12,13,50", "DecoPlatformSlopeBaseCurve1OutFull 12,13,51",
      "DecoPlatformSlopeBase 13,13,51", "DecoPlatformSlopeBase 14,13,51", "DecoPlatformSlopeBase 15,13,51", "DecoPlatformSlopeBase 16,13,51",
      "DecoPlatformSlopeBase 17,13,48", "DecoPlatformSlopeBase 17,13,49", "DecoPlatformSlopeBase 17,13,50", "DecoPlatformSlopeBaseCurve1OutFull 17,13,51"] },
    // guide walls stay plastic
    "Egypt 2026": { "name": "Fall 2026 - 21 Egypt",
      "keepItems": ["InflatableBorder*", "InflatableMat1m*"],
      "removeItems": ["InflatableBorder1mCornerOut 1151.5, 66.5, 1264.5"] },
    "Czech Republic 2026": { "name": "Fall 2026 - 23 Czech Republic", "keepItems": ["InflatableBorder*"] },
    "United Kingdom 2026": { "name": "Fall 2026 - 22 United Kingdom", "options": { "snowOnGroundDeco": false } },
    "India 2026": { "name": "Fall 2026 - 24 India" },
    "New Zealand 2026": { "name": "Fall 2026 - 25 New Zealand" }
  }
}
