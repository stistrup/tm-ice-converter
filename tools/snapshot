#!/usr/bin/env bash
# snapshot <maps folder> <dir>: convert into <dir>/now and compare hashes with <dir>/baseline.sha (written if missing).
# Same hashes = same maps, items and custom blocks; item files are only rebuilt when their mesh data changes.
set -euo pipefail
[ $# -eq 2 ] || { echo "usage: snapshot <maps folder> <dir>" >&2; exit 2; }
root="$(dirname "$(readlink -f "$0")")/.."
maps=$1 dir=$2
rm -rf "$dir/now"
mkdir -p "$dir/now"
dotnet build "$root" -c Release -v q --nologo >/dev/null
dotnet "$root/bin/Release/net10.0/TmSurfaceEditor.dll" convert "$maps" --settings current --folder "$(readlink -f "$dir")/now" --fake-author-time --me-as-author --rebuild-blocks > "$dir/now.log" 2>&1
hashes=$(cd -- "$dir/now" && sha256sum -- * | sort -k2)
if [ ! -f "$dir/baseline.sha" ]; then
    printf '%s\n' "$hashes" > "$dir/baseline.sha"
    echo "baseline: $(printf '%s\n' "$hashes" | wc -l) files"
elif diff <(printf '%s\n' "$hashes") "$dir/baseline.sha" > "$dir/diff.txt"; then
    echo "same: $(printf '%s\n' "$hashes" | wc -l) files"
else
    echo "DIFFERENT: $(grep -c '^<' "$dir/diff.txt") files, see $dir/diff.txt" >&2
    exit 1
fi
