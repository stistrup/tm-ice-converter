<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);archive/**;web/**;dist/**</DefaultItemExcludes>
    <!-- the release; the GUI shows it and checks GitHub for a newer one -->
    <Version>0.1.0</Version>
    <!-- maps convert on several threads at once: about a third faster than the desktop GC, same peak memory -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <!-- parked: see the file -->
    <Compile Remove="Packaging/Thumbnails.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GBX.NET" Version="2.4.5" />
    <PackageReference Include="GBX.NET.LZO" Version="2.1.6" />
    <PackageReference Include="GBX.NET.ZLib" Version="1.1.2" />
  </ItemGroup>

</Project>
